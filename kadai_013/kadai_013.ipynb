      "source": [
        "#kadai_011 関数\n",
        "\n",
        "def calc(price,rate = 10):\n",
        "  t_price = price * ((100 + rate)/100)\n",
        "  return(t_price)\n",
        "\n",
        "price = 100\n",
        "total = calc(price)\n",
        "\n",
        "#表示\n",
        "print(\"税抜\",price,\"円　税込\",total,\"円\")\n"
      ]
