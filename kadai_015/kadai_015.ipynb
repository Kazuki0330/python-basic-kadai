        "#kadai_015 クラス\n",
        "\n",
        "class Human:\n",
        "    def __init__(self, name, age):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "\n",
        "    def printinfo(self):\n",
        "        print(\"名前:\",self.name, \"年齢:\",self.age,\"歳\")\n",
        "\n",
        "human1 = Human(\"太郎\", 25)\n",
        "human1.printinfo()\n"
      ],
